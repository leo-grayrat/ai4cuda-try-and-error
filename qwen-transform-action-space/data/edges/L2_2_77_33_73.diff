+def triton_global_avg_pool3d(x: torch.Tensor):
+    """
+    Compute AdaptiveAvgPool3d((1,1,1)) using a Triton kernel.
+    Accepts input x of shape (N, C, D, H, W). Returns (N, C, 1, 1, 1) float32 tensor.
+    The kernel accumulates in float32 for accuracy even if input is float16.
+    """
+    assert x.is_cuda, "Triton pooling requires CUDA tensor"
+    N, C, D, H, W = x.shape
+    DHW = D * H * W
+
+    # Ensure input is contiguous in default layout for easier stride calculations.
+    # We try to avoid unnecessary copying if already contiguous.
+    if not x.is_contiguous():
+        x = x.contiguous()
+
+    # Prepare output flat tensor of shape (N*C,)
+    out = torch.empty((N * C,), dtype=torch.float32, device=x.device)
+
+    stride_n, stride_c, stride_d, stride_h, stride_w = x.stride()
+
+    # grid size: one program per (n,c)
+    grid = (N * C,)
+
+    mean_spatial_kernel[grid](
+        x,
+        out,
+        N, C, D, H, W,
+        stride_n, stride_c, stride_d, stride_h, stride_w,
+        DHW,
+    )
+    # reshape to (N, C, 1, 1, 1)
+    out = out.view(N, C, 1, 1, 1)
+    return out
