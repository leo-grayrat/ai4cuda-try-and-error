+def mean_spatial_kernel(
+    x_ptr,           # pointer to input tensor (N, C, D, H, W)
+    out_ptr,         # pointer to output tensor (N*C,) float32 where each entry = mean over spatial
+    N, C, D, H, W,   # dims
+    stride_n, stride_c, stride_d, stride_h, stride_w,  # strides of input tensor
+    DHW,             # total spatial elements = D*H*W
+    BLOCK: tl.constexpr,
+):
+    """
+    Each program computes the mean over spatial dims for one (n, c) pair.
+    Grid size = N * C. program_id selects idx in [0..N*C)
+    The kernel processes the spatial dimension in chunks of size BLOCK.
+    """
+    pid = tl.program_id(0)  # linear id in [0, N*C)
+    n = pid // C
+    c = pid % C
+
+    base = n * stride_n + c * stride_c  # base offset into x for this (n,c)
+
+    acc = tl.zeros((1,), dtype=tl.float32)[0]
+
+    # Loop over chunks of spatial positions
+    num_iters = (DHW + BLOCK - 1) // BLOCK
+    for it in range(num_iters):
+        offs = it * BLOCK + tl.arange(0, BLOCK)
+        mask = offs < DHW
+
+        # compute d,h,w from linear offset offs
+        # offs is a vector; do integer arithmetic
+        wh = H * W
+        d = offs // wh
+        rem = offs - d * wh
+        h = rem // W
+        w = rem - h * W
+
+        # compute addresses for loads
+        addr = base + d * stride_d + h * stride_h + w * stride_w
+
+        vals = tl.load(x_ptr + addr, mask=mask, other=0.0)
+        # cast to float32 accumulator
+        acc = acc + tl.cast(vals, tl.float32)
+
+    # divide by total elements to get mean
+    mean_val = acc / tl.cast(DHW, tl.float32)
+    # store result to out_ptr at index pid (one value per (n,c))
+    tl.store(out_ptr + pid, mean_val)
