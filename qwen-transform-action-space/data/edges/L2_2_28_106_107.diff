+
+@triton.autotune(configs=AUTOTUNE_FUSED, key=['n_elements'])
+@triton.jit
+def fused_add_mul_kernel(a_ptr, y_ptr, out_ptr, n_elements, BLOCK: tl.constexpr):
+    """
+    Fused kernel that computes out[i] = (a[i] + y[i]) * y[i] for flattened tensors.
+    Each program handles a contiguous BLOCK of elements to minimize memory traffic.
+    """
+    pid = tl.program_id(0)
+    start = pid * BLOCK
+    offsets = start + tl.arange(0, BLOCK)
+    mask = offsets < n_elements
+
+    a = tl.load(a_ptr + offsets, mask=mask, other=0.0)
+    yv = tl.load(y_ptr + offsets, mask=mask, other=0.0)
+    out = (a + yv) * yv
+    tl.store(out_ptr + offsets, out, mask=mask)
+
