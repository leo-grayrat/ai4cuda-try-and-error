+class TritonLinearDetachedResidual(torch.autograd.Function):
+    """
+    Custom autograd Function:
+      forward: computes out = (input @ weight.T + bias) * (scale + 1.0) using Triton kernel for speed.
+      backward: implements detached-residual semantics: only the scaled path contributes to gradients,
+                i.e., grad_acc = grad_output * scale. Gradients for input, weight, bias are computed via torch.mm
+                (leveraging cuBLAS) using fp32 accumulations.
+    """
+
+    @staticmethod
+    def forward(ctx, input, weight, weight_t, bias, scaling_factor, use_fp16=False, weight_t_half=None):
+        """
+        input: (M, K) float32
+        weight: (N, K) float32 (nn.Linear weight)
+        weight_t: (K, N) contiguous transposed float32
+        bias: (N,) or None
+        scaling_factor: float scalar
+        use_fp16: whether to use the mixed-precision fast path (requires weight_t_half)
+        weight_t_half: optional precomputed half (K, N)
+        """
+        device = weight.device
+        # Move input/bias to device if needed
+        if (not input.is_cuda) and device.type == "cuda":
+            input = input.cuda(device)
+        if bias is not None and (not bias.is_cuda) and device.type == "cuda":
+            bias = bias.cuda(device)
+
+        # Choose precision path
+        if use_fp16 and (weight_t_half is not None):
+            a = input.half()
+            b_t = weight_t_half
+        else:
+            a = input
+            b_t = weight_t
+
+        # Compute fused forward: out = acc * (scale + 1.0)
+        out = triton_linear_from_t(a, b_t, bias=bias, scale=scaling_factor)
+
+        # Save necessary tensors for backward (we need original input & weight & bias & scaling)
+        ctx.save_for_backward(input, weight, bias if bias is not None else torch.empty(0, device=input.device))
+        ctx.scaling_factor = float(scaling_factor)
+        return out
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        # Retrieve saved tensors
+        saved = ctx.saved_tensors
+        input = saved[0]
+        weight = saved[1]
+        bias_saved = saved[2]
+        has_bias = bias_saved.numel() != 0
+        s = ctx.scaling_factor
+
+        # Only the scaled path contributes to gradients
+        grad_acc = grad_output * s  # shape (M, N), float32
+
+        grad_input = grad_weight = grad_bias = None
+
+        # grad_input = grad_acc @ weight  (weight: N x K)
+        if ctx.needs_input_grad[0]:
+            grad_input = grad_acc.mm(weight)
+
+        # grad_weight = grad_acc.T @ input  -> (N x M) @ (M x K) => (N x K)
+        if ctx.needs_input_grad[1]:
+            grad_weight = grad_acc.t().mm(input)
+
+        if ctx.needs_input_grad[3] and has_bias:
+            grad_bias = grad_acc.sum(0)
+
+        # For non-tensor args like scaling_factor and use_fp16 and weight_t/weight_t_half, return None
+        return grad_input, grad_weight, None, grad_bias, None, None, None
