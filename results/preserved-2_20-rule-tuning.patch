diff --git a/tests/test_credit_case.py b/tests/test_credit_case.py
index dfb2ab6..7979e21 100644
--- a/tests/test_credit_case.py
+++ b/tests/test_credit_case.py
@@ -63,3 +63,22 @@ def test_prepared_case_writes_one_selective_revert_for_separate_action(tmp_path)
         candidate = tmp_path / "case" / f"without-{action['id']}.py"
         assert candidate.exists()
         assert candidate.read_text(encoding="utf-8") != child
+
+
+def test_ordinary_code_control_takes_priority_over_comment_only_change(tmp_path) -> None:
+    parent = (
+        "@triton.jit\ndef kernel(x):\n    y = x\n\n"
+        "# Old note\n"
+        "def metadata():\n    return 'old'\n"
+    )
+    child = parent.replace("y = x", "y = x + 1").replace("Old note", "New note").replace("'old'", "'new'")
+    trace = prepare_case(
+        parent_source=parent, child_source=child,
+        reference_source="class Model: pass\n",
+        out_dir=tmp_path / "case", experiment_id="ordinary-control",
+        provenance={"task": "2_1", "parent_node": 1, "child_node": 2},
+    )
+    control = next(action for action in trace["actions"] if action["score"] == 0 and action["candidate_id"])
+    reverted = (tmp_path / "case" / f"{control['candidate_id']}.py").read_text(encoding="utf-8")
+    assert "# New note" in reverted
+    assert "return 'old'" in reverted
